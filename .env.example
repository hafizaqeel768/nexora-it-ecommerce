# Copy to .env and set a real password. .env is git-ignored.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Database URL for tools running on WSL/Windows (DB clients, one-off scripts): host port on 127.0.0.1.
# Inside Docker, docker-compose.yml overrides this for nexora_app with the container hostname:
#   postgresql://USER:PASSWORD@nexora_pg:5432/DATABASE?schema=public
DATABASE_URL="postgresql://nexora:change-me@127.0.0.1:5432/nexora?schema=public"

# Auth.js (Phase 8): signs the login session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# ---------- Email (Phase 10) ----------
# Development: docker-compose.yml points the app at Mailpit (MAILPIT_URL), inbox at http://localhost:8025.
# Production: set a Resend API key; EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Nexora IT <orders@nexora.test>"
# Public site URL used for links in emails
APP_URL=http://localhost:3100
# Abandoned-cart reminder after this many hours without changes (signed-in customers with a confirmed email)
ABANDONED_CART_HOURS=3
# Enables GET /api/cron/email-jobs for an external scheduler (send it as "Authorization: Bearer <secret>")
CRON_SECRET=

# ---------- Payments (Phase 7) ----------
# Stripe secret key. Card payments stay off until it is set. Use sk_test_… in development; sk_live_… only works in production.
STRIPE_SECRET_KEY=
