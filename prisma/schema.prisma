// Nexora IT — data model (Phase 5).
// Shapes follow design/nexora-full-with-admin.html (products, variants, bulk tiers, reviews, orders,
// quotes, coupons, wishlist) and docs/kijero-products.json (the real catalog).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  BACKORDER
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  PURCHASE_ORDER
  BANK_TRANSFER
}

enum QuoteStatus {
  NEW
  CONTACTED
  WON
  CLOSED
}

/// Two levels: top-level (site nav) → subcategories (from the catalog JSON).
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  /// Public path, e.g. /media/category/monitors.webp
  image       String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  quotes      Quote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  sku              String?          @unique
  mpn              String?
  name             String
  brand            String
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price            Decimal          @db.Decimal(10, 2)
  /// Previous price, shown struck through ("old" in the prototype)
  compareAtPrice   Decimal?         @db.Decimal(10, 2)
  currency         String           @default("USD")
  /// null = quantity not tracked (catalog import has availability only)
  stock            Int?
  availability     Availability     @default(IN_STOCK)
  condition        ProductCondition @default(NEW)
  status           ProductStatus    @default(ACTIVE)
  shortDescription String?
  description      String?
  /// Raw HTML from the catalog source — sanitize before rendering
  descriptionHtml  String?
  /// Ordered [{ label, value }]
  specs            Json?
  /// { length, width, height, weight } as given by the source, e.g. "4.4 in"
  packaging        Json?
  /// Main image, public path under /media
  image            String?
  /// Additional images (public paths)
  gallery          String[]         @default([])
  /// Cached average of reviews (prototype "r")
  rating           Decimal?         @db.Decimal(2, 1)
  /// Prototype demo product — easy to find and remove
  isSample         Boolean          @default(false)
  sourceUrl        String?
  variants         Variant[]
  priceTiers       PriceTier[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([status])
}

/// Selectable option with a price delta, e.g. "Storage: 1TB SSD (+$130)".
model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Option group label, e.g. "Memory / Storage"
  attribute  String
  name       String
  priceDelta Decimal     @default(0) @db.Decimal(10, 2)
  sku        String?
  stock      Int?
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@index([productId])
}

/// Bulk pricing: quantities minQty..maxQty pay price × multiplier.
model PriceTier {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty     Int
  /// null = no upper bound
  maxQty     Int?
  multiplier Decimal @db.Decimal(4, 3)

  @@unique([productId, minQty])
}

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  body       String
  approved   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([productId])
}

/// Shop customer / admin. Guest checkouts create a row without a password; registering sets one.
/// Login is Auth.js credentials with JWT sessions, so no Auth.js Account/Session tables are needed.
model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  phone         String?
  role          Role           @default(CUSTOMER)
  /// scrypt hash (src/lib/password.ts); null = guest, cannot log in
  passwordHash  String?
  /// When the account was registered; until the email is verified, order history starts here
  registeredAt  DateTime?
  /// Set by the verification link; verified accounts also see guest orders placed with their email
  emailVerifiedAt   DateTime?
  /// Sessions issued before this are rejected (password reset signs out other devices)
  passwordChangedAt DateTime?
  /// B2B tax exemption (resale/exempt certificate on file): no tax at checkout when signed in
  taxExempt     Boolean        @default(false)
  authTokens    AuthToken[]
  savedCart     SavedCart?
  addressLine   String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Order {
  id              String        @id @default(cuid())
  /// Human-readable, e.g. NX-100240
  number          String        @unique
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  email           String
  phone           String?
  addressLine     String
  city            String
  state           String
  postalCode      String
  country         String
  /// ISO 3166 code of the shipping country (orders before Phase 11: null)
  countryCode     String?
  /// Shipping method name as chosen at checkout, e.g. "Standard (3–5 business days)"
  shippingMethod  String?
  /// Tax rate applied, in percent (null for older orders)
  taxRate         Decimal?      @db.Decimal(6, 3)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  /// Stripe Checkout session for card payments
  stripeSessionId String?       @unique
  status          OrderStatus   @default(PENDING)
  couponCode      String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  notes           String?
  items           OrderItem[]
  quote           Quote?
  emails          OrderEmail[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
}

/// Snapshot of what was bought; product/variant links survive deletion as null.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  sku       String?
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

enum OrderEmailKind {
  CONFIRMATION
  STATUS
}

/// Email about an order (the prototype's emailLog): the confirmation, then one per status change.
/// Rows are queued first and sent right after (src/lib/order-emails.ts); failed ones are retried by the jobs.
model OrderEmail {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        OrderEmailKind @default(STATUS)
  /// The status the email announces
  orderStatus OrderStatus
  to          String
  /// null = not sent yet
  sentAt      DateTime?
  error       String?
  attempts    Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  percentOff Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  /// Human-readable, e.g. QT-48211
  number     String      @unique
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  company    String?
  email      String
  phone      String?
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Free text as entered, e.g. "40"
  quantity   String?
  message    String
  status     QuoteStatus @default(NEW)
  /// Set when the quote is converted to an order
  orderId    String?     @unique
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
}

/// Admin settings (Phase 11): one JSON document per section ("store", "checkout", "payments", "email",
/// "inventory"). Shapes, defaults and validation live in src/lib/config.ts.
model StoreConfig {
  section   String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ShippingKind {
  FLAT
  PICKUP
}

/// Where the store ships. The first zone (by sortOrder) matching the address wins; a zone without
/// countries is "rest of the world".
model ShippingZone {
  id        String           @id @default(cuid())
  name      String
  /// ISO 3166 country codes; empty = every country not matched by another zone
  countries String[]         @default([])
  /// Optional state codes (e.g. TX, CA); empty = the whole country
  states    String[]         @default([])
  sortOrder Int              @default(0)
  methods   ShippingMethod[]
  createdAt DateTime         @default(now())
}

model ShippingMethod {
  id          String       @id @default(cuid())
  zoneId      String
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// Shown at checkout, e.g. "Standard (3–5 business days)"
  name        String
  kind        ShippingKind @default(FLAT)
  price       Decimal      @default(0) @db.Decimal(10, 2)
  /// Free when the discounted subtotal reaches this amount
  freeFrom    Decimal?     @db.Decimal(10, 2)
  /// Only offered from this subtotal (e.g. freight for large orders)
  minSubtotal Decimal?     @db.Decimal(10, 2)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)

  @@index([zoneId])
}

/// Sales tax. Most specific match wins: country + state, then country, then "*" (everywhere).
model TaxRate {
  id       String  @id @default(cuid())
  name     String
  /// ISO 3166 code, or "*" for every country
  country  String
  /// State code, or "" for the whole country
  state    String  @default("")
  /// Percent, e.g. 8.25
  rate     Decimal @db.Decimal(6, 3)
  /// Also charge this tax on the shipping fee
  shipping Boolean @default(false)

  @@unique([country, state])
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One-time link tokens. Only a SHA-256 hash is stored; the token itself is only in the email.
model AuthToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([customerId, purpose])
}

/// Server copy of a signed-in customer's cart, for abandoned-cart reminders and restoring on another device.
model SavedCart {
  customerId String    @id
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// [{ productId, variantId, quantity }]
  lines      Json
  /// When the lines last changed (set by the app; sending a reminder doesn't count as a change)
  changedAt  DateTime  @default(now())
  /// Reminder sent for this version of the cart; cleared when the cart changes
  remindedAt DateTime?
}
